#!/bin/bash

# Redirect all output for post-boot debugging
exec > /root/userdata.log 2>&1

# -----------------------------------------------------------------------
# WAIT FOR NETWORK
# OCI fires cloud-init before internet routing is fully established
# -----------------------------------------------------------------------
echo "NOTE: Waiting for network connectivity..."
until curl -4 -sf --max-time 5 http://archive.ubuntu.com/ > /dev/null 2>&1 && \
      curl -4 -sf --max-time 5 https://github.com/ > /dev/null 2>&1; do
  echo "NOTE: Network not ready, retrying in 10 seconds..."
  sleep 10
done
echo "NOTE: Network ready."

# Force IPv4 for apt — OCI NAT gateway drops IPv6 silently
echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4

# Map the friendly FQDN to the PostgreSQL private IP — OCI managed PostgreSQL
# does not support hostname_label so /etc/hosts is the only reliable option
echo "${POSTGRES_IP} ${POSTGRES_HOST}" >> /etc/hosts

# -----------------------------------------------------------------------
# UPDATE & INSTALL DEPENDENCIES
# Retry loop handles the apt lock race at early OCI boot
# -----------------------------------------------------------------------
for attempt in $(seq 1 10); do
  apt-get update -y && break
  echo "NOTE: apt-get update attempt $attempt failed, retrying in 30s..."
  pkill -9 -f apt 2>/dev/null || true
  sleep 30
done

apt-get install -y postgresql-client unzip wget git

# OCI Ubuntu images have a catch-all iptables REJECT rule — insert ACCEPT for
# port 80 before it so external traffic can reach pgweb
iptables -I INPUT 5 -p tcp --dport 80 -j ACCEPT

# Set ubuntu user password for SSH password / console fallback
echo "ubuntu:${VM_PASSWORD}" | chpasswd

# -----------------------------------------------------------------------
# LOAD PAGILA SAMPLE DATABASE
# -----------------------------------------------------------------------
POSTGRES_HOST="${POSTGRES_HOST}"
POSTGRES_PORT="${POSTGRES_PORT}"
POSTGRES_USER="${POSTGRES_USER}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD}"

cd /tmp
git clone https://github.com/mamonaco1973/oci-postgres.git
cd oci-postgres/01-postgres/data

echo "NOTE: Loading Pagila database..." >> /root/db_load.log 2>&1

PGPASSWORD=$POSTGRES_PASSWORD psql -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" \
  -U "$POSTGRES_USER" -d postgres \
  -f pagila-db.sql >> /root/db_load.log 2>&1

PGPASSWORD=$POSTGRES_PASSWORD psql -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" \
  -U "$POSTGRES_USER" -d pagila \
  -f pagila-schema.sql >> /root/db_load.log 2>&1

PGPASSWORD=$POSTGRES_PASSWORD psql -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" \
  -U "$POSTGRES_USER" -d pagila \
  -f pagila-data.sql >> /root/db_load.log 2>&1

echo "NOTE: Pagila load complete." >> /root/db_load.log 2>&1

# -----------------------------------------------------------------------
# INSTALL PGWEB
# -----------------------------------------------------------------------
cd /tmp
wget https://github.com/sosedoff/pgweb/releases/download/v0.16.2/pgweb_linux_amd64.zip
unzip pgweb_linux_amd64.zip >> /root/pgweb.log 2>&1
chmod +x pgweb_linux_amd64
mv pgweb_linux_amd64 /usr/local/bin/pgweb

if [ ! -f "/usr/local/bin/pgweb" ]; then
  echo "ERROR: pgweb binary not found after install"
  exit 1
fi

# -----------------------------------------------------------------------
# CONFIGURE PGWEB AS A SYSTEMD SERVICE
# -----------------------------------------------------------------------
cat <<EOF > /etc/systemd/system/pgweb.service
[Unit]
Description=Pgweb - Web UI for PostgreSQL
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/pgweb --listen=80 --bind 0.0.0.0
Restart=on-failure
User=root
WorkingDirectory=/root

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reexec
systemctl daemon-reload
systemctl enable pgweb
systemctl start pgweb
systemctl status pgweb | cat >> /root/pgweb.log 2>&1

echo "NOTE: Done."
