#!/bin/bash

# Redirect all output for post-boot debugging
exec > /root/userdata.log 2>&1

# -----------------------------------------------------------------------
# WAIT FOR NETWORK
# OCI fires cloud-init before internet routing is fully established
# -----------------------------------------------------------------------
echo "NOTE: Waiting for network connectivity..."
until curl -4 -sf --max-time 5 http://archive.ubuntu.com/ > /dev/null 2>&1; do
  echo "NOTE: Network not ready, retrying in 10 seconds..."
  sleep 10
done
echo "NOTE: Network ready."

# Force IPv4 for apt — OCI NAT gateway drops IPv6 silently
echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4

# -----------------------------------------------------------------------
# UPDATE & INSTALL WEB + PHP + MYSQL CLIENT TOOLS
# Retry loop handles the apt lock race at early OCI boot
# -----------------------------------------------------------------------
for attempt in $(seq 1 10); do
  apt-get update -y && break
  echo "NOTE: apt-get update attempt $attempt failed, retrying in 30s..."
  pkill -9 -f apt 2>/dev/null || true
  sleep 30
done

apt-get install -y apache2 php php-mysql php-mbstring php-zip php-gd php-json php-curl php-xml unzip mysql-client-core-8.0

# OCI Ubuntu images have a catch-all iptables REJECT rule — insert ACCEPT for
# port 80 before it so external traffic can reach Apache
iptables -I INPUT 5 -p tcp --dport 80 -j ACCEPT

# Set ubuntu user password for SSH password / console fallback
echo "ubuntu:${VM_PASSWORD}" | chpasswd

# -----------------------------------------------------------------------
# DOWNLOAD & DEPLOY PHPMYADMIN
# -----------------------------------------------------------------------
cd /usr/share

sudo wget https://files.phpmyadmin.net/phpMyAdmin/5.2.2/phpMyAdmin-5.2.2-all-languages.zip
sudo unzip -o -q phpMyAdmin-5.2.2-all-languages.zip
sudo mv phpMyAdmin-5.2.2-all-languages phpmyadmin
sudo chown -R www-data:www-data /usr/share/phpmyadmin

# -----------------------------------------------------------------------
# CONFIGURE APACHE TO SERVE PHPMYADMIN
# -----------------------------------------------------------------------
sudo tee /etc/apache2/conf-available/phpmyadmin.conf > /dev/null <<EOF
Alias /phpmyadmin /usr/share/phpmyadmin

<Directory /usr/share/phpmyadmin>
    Options SymLinksIfOwnerMatch
    DirectoryIndex index.php
    Require all granted
</Directory>
EOF

sudo a2enconf phpmyadmin
sudo systemctl reload apache2

# -----------------------------------------------------------------------
# CONFIGURE PHPMYADMIN TO CONNECT TO REMOTE MYSQL SERVER
# -----------------------------------------------------------------------
MYSQL_HOST="${MYSQL_HOST}"
PASSWORD="${PASSWORD}"
USER="${USER}"

sudo cp /usr/share/phpmyadmin/config.sample.inc.php /usr/share/phpmyadmin/config.inc.php

sudo sed -i "s|\(\$cfg\['blowfish_secret'\] = \).*|\1'$(openssl rand -hex 16)';|" /usr/share/phpmyadmin/config.inc.php
sudo sed -i "s|\(\$cfg\['Servers'\]\[\$i\]\['host'\] = \).*|\1'$MYSQL_HOST';|" /usr/share/phpmyadmin/config.inc.php

# OCI MySQL HeatWave requires TLS — disable cert verification for lab use
sudo tee -a /usr/share/phpmyadmin/config.inc.php > /dev/null <<'EOF'
$cfg['Servers'][$i]['ssl'] = true;
$cfg['Servers'][$i]['ssl_verify'] = false;
EOF

# -----------------------------------------------------------------------
# REPLACE DEFAULT INDEX.HTML WITH REDIRECT TO /phpmyadmin
# -----------------------------------------------------------------------
sudo tee /var/www/html/index.html > /dev/null <<EOF
<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="refresh" content="0; url=./phpmyadmin" />
    <script>
      window.location.href = "./phpmyadmin";
    </script>
    <title>Redirecting...</title>
  </head>
  <body>
    If you are not redirected automatically, <a href="./phpmyadmin">click here</a>.
  </body>
</html>
EOF

sudo systemctl restart apache2

# -----------------------------------------------------------------------
# DOWNLOAD & LOAD SAKILA SAMPLE DATABASE
# -----------------------------------------------------------------------
cd /tmp
rm -f -r sakila-db
rm -f -r sakila*.zip*

wget -q https://downloads.mysql.com/docs/sakila-db.zip
unzip -o -q sakila-db.zip

mysql -h "$MYSQL_HOST" -u "$USER" -p"$PASSWORD" --ssl-mode=REQUIRED -e "CREATE DATABASE IF NOT EXISTS sakila;"
mysql -h "$MYSQL_HOST" -u "$USER" -p"$PASSWORD" --ssl-mode=REQUIRED sakila < ./sakila-db/sakila-schema.sql
mysql -h "$MYSQL_HOST" -u "$USER" -p"$PASSWORD" --ssl-mode=REQUIRED sakila < ./sakila-db/sakila-data.sql
mysql -h "$MYSQL_HOST" -u "$USER" -p"$PASSWORD" --ssl-mode=REQUIRED < /usr/share/phpmyadmin/sql/create_tables.sql

echo "NOTE: Done."
